{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ANSA Flasher Manifest Schema",
  "type": "object",
  "required": [
    "boards"
  ],
  "properties": {
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mcu",
          "transport",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mcu": {
            "type": "string"
          },
          "transport": {
            "type": "string",
            "enum": [
              "swd",
              "dfu",
              "uart"
            ]
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "version",
                "channel",
                "url",
                "sha256",
                "signature_url",
                "size_bytes"
              ],
              "properties": {
                "version": {
                  "type": "string"
                },
                "channel": {
                  "type": "string",
                  "enum": [
                    "stable",
                    "beta"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "signature_url": {
                  "type": "string"
                },
                "size_bytes": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
